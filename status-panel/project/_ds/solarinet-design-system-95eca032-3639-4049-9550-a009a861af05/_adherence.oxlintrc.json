        "selector": "JSXOpeningElement[name.name='MetricBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:pct|width|height|showValue|color|style|key|ref|className|style|children)$/]",
        "message": "<MetricBar> doesn't accept that prop. Declared props: pct, width, height, showValue, color, style."
