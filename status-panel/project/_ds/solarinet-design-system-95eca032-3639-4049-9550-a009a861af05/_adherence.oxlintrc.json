{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/charts/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/navigation/**",
              "components/status/**",
              "src/js/**",
              "ui_kits/monitoring-dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:severity|title|detail|meta|cleared|onClick|style|key|ref|className|style|children)$/]",
        "message": "<AlertRow> doesn't accept that prop. Declared props: severity, title, detail, meta, cleared, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertRow'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:crit|warn|info)$/]",
        "message": "<AlertRow> severity must be one of 'crit' | 'warn' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BandwidthGauge'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|used|cap|format|color|style|key|ref|className|style|children)$/]",
        "message": "<BandwidthGauge> doesn't accept that prop. Declared props: label, used, cap, format, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|wordmark|satelliteStates|style|key|ref|className|style|children)$/]",
        "message": "<BrandMark> doesn't accept that prop. Declared props: size, wordmark, satelliteStates, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|icon|state|count|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: active, icon, state, count, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:up|degraded|down|maintenance|unknown|stale)$/]",
        "message": "<Chip> state must be one of 'up' | 'degraded' | 'down' | 'maintenance' | 'unknown' | 'stale'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Command'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|group|label|icon|state|sub|keywords|action|key|ref|className|style|children)$/]",
        "message": "<Command> doesn't accept that prop. Declared props: id, group, label, icon, state, sub, keywords, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|render|key|ref|className|style|children)$/]",
        "message": "<DataColumn> doesn't accept that prop. Declared props: key, label, align, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<DataColumn> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|icon|title|description|actionLabel|onAction|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: kind, icon, title, description, actionLabel, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:not-configured|no-data|filtered)$/]",
        "message": "<EmptyState> kind must be one of 'not-configured' | 'no-data' | 'filtered'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HealthRoll'] > JSXAttribute > JSXIdentifier[name!=/^(?:total|up|degraded|down|maintenance|unknown|key|ref|className|style|children)$/]",
        "message": "<HealthRoll> doesn't accept that prop. Declared props: total, up, degraded, down, maintenance, unknown."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heartbeat'] > JSXAttribute > JSXIdentifier[name!=/^(?:beats|missed|age|width|height|style|key|ref|className|style|children)$/]",
        "message": "<Heartbeat> doesn't accept that prop. Declared props: beats, missed, age, width, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|className|style|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, className, style, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:overview|server|host|monitor|reachability|topology|alerts|discovery|provision|settings|cpu|ram|disk|network|bandwidth|activity|process|search|command|grid|table|cards|bell|sun|moon|menu|close|chevronLeft|chevronRight|check|refresh|survey|filter|shield|pulse|clock|arch|chip|link|plus|enter|gateway|netswitch|wifi)$/]",
        "message": "<Icon> name must be one of 'overview' | 'server' | 'host' | 'monitor' | 'reachability' | 'topology' | 'alerts' | 'discovery' | 'provision' | 'settings' | 'cpu' | 'ram' | 'disk' | 'network' | 'bandwidth' | 'activity' | 'process' | 'search' | 'command' | 'grid' | 'table' | 'cards' | 'bell' | 'sun' | 'moon' | 'menu' | 'close' | 'chevronLeft' | 'chevronRight' | 'check' | 'refresh' | 'survey' | 'filter' | 'shield' | 'pulse' | 'clock' | 'arch' | 'chip' | 'link' | 'plus' | 'enter' | 'gateway' | 'netswitch' | 'wifi'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|active|size|glyph|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, active, size, glyph."
      },
