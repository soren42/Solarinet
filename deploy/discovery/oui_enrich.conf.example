# oui_enrich — MAC->vendor OUI enricher config (sample).
#
# Copy to oui_enrich.conf (gitignored — it may hold the DB password) and
# edit. INI format, read with Python's configparser — same [db] shape as
# avahi_import.conf.example / mdns_inspect.conf.example.
#
#   cp deploy/discovery/oui_enrich.conf.example deploy/discovery/oui_enrich.conf
#   chmod 600 deploy/discovery/oui_enrich.conf

[db]
# The xenon `solarinet` MariaDB (server-local). Leave `password` blank (or a
# CHANGE_ME placeholder) to source it from $SOLARI_DB_PASS instead — e.g. by
# `source run/db.env` before running, same convention as
# deploy/alertbridge/alertbridge.py and deploy/discovery/avahi_import.conf.example.
host = 127.0.0.1
port = 3306
user = solari
name = solarinet
password =
