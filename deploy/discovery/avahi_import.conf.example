# avahi_import — Avahi/mDNS discovery importer config (sample).
#
# Copy to avahi_import.conf (gitignored — it may hold the DB password) and
# edit. INI format, read with Python's configparser.
#
#   cp deploy/discovery/avahi_import.conf.example deploy/discovery/avahi_import.conf
#   chmod 600 deploy/discovery/avahi_import.conf

[db]
# The xenon `solarinet` MariaDB (server-local). Leave `password` blank (or a
# CHANGE_ME placeholder) to source it from $SOLARI_DB_PASS instead — e.g. by
# `source run/db.env` before running, same convention as
# deploy/alertbridge/alertbridge.py and deploy/systemd/solarinet-snmp.service.
host = 127.0.0.1
port = 3306
user = solari
name = solarinet
password =
