[Unit]
Description=Refresh chlorine's authoritative secondary zones from xenon
After=network-online.target named.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=oneshot
User=jason
Group=jason
ExecStart=/usr/bin/python3 /usr/local/libexec/solari-dns-secondary-refresh --primary-config /etc/bind/solarinet-current/named.conf.managed --additional-config /etc/bind/named.conf.rpz
TimeoutStartSec=120
Restart=on-failure
RestartSec=30
