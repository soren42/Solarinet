; SolariNet production server configuration. Install at /etc/solarinet/server.conf
; and set SOLARI_DB_PASS in /etc/solarinet/server.env (0600 solari:solari).
; Paths and certificate names must match the local PKI installation.

[identity]
hostFqdn = xenon.akoria.net

[bind]
ingestUrl = tls+tcp://0.0.0.0:7701
surveyUrl = tls+tcp://0.0.0.0:7702
controlUrl = tls+tcp://0.0.0.0:7702
pubUrl = tls+tcp://0.0.0.0:7703
ctlSocket = /run/solari/solariCtl.sock
useTls = true

[tls]
caFile = /var/lib/solarinet/pki/ca.pem
certFile = /var/lib/solarinet/pki/server.pem
keyFile = /var/lib/solarinet/pki/server.key

[ca]
mode = local
certFile = /var/lib/solarinet/pki/ca.pem
keyFile = /var/lib/solarinet/pki/ca.key

[db]
host = 127.0.0.1
port = 3306
name = solarinet
user = solari
poolSize = 4

[lease]
leaseRenewSec = 5
leaseTtlSec = 15

[discovery]
autoDiscover = true
autoEnroll = false

[ingest]
# Rolling-upgrade bridge only. true accepts one-way reports from agents that
# predate TLV_REPORT_SESSION (no durable receipt; in-memory replay guard).
# Like the pre-RC server, the guard is seqNo-only: after a legacy agent
# restarts, reports whose seqNo is still in the 1024-entry ring are dropped
# until the agent passes them. Restart legacy agents sparingly.
# Set false once every client/monitor runs a session-aware build.
allowLegacyReports = false

[ctl]
# Privileged ctl verbs (SIGN, IMAGE_REFRESH, PROV_STAGE, STACK_APPLY, ...) are
# allowed only to root and operatorUid (default: the server's own uid), even
# with enforcePeer = false; every other peer is enqueue-only. Operator scripts
# that call solariCtlClient directly (deploy-monitor.sh, remote-deploy.sh) must
# run as root or as operatorUid.
enforcePeer = true
operatorUid = solari
dashboardUid = www-solari
socketGid = solari-ctl
# Fleet/deploy helpers (deploy/remote-deploy.sh, deploy/fleet/*) are exec'd by
# absolute path under helperRoot; default = the server's working directory
# (the release root, /opt/solarinet/current), pinned with realpath at start so
# an in-flight cutover cannot swap helpers mid-run. Helper logs
# (deploy-<host>.log, provision-<host>.log, ...) land in logDir; default = the
# ctl socket's directory, which is where the dashboard tails them. A verb whose
# helper is missing/non-executable or whose log cannot be opened replies ERR.
# helperRoot = /opt/solarinet/current
# logDir = /run/solari
