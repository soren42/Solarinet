# /etc/systemd/system/solarinet-monitor.service
[Unit]
Description=SolariNet monitor outpost (reachability probes -> server)
After=network-online.target solarinet-server.service
Wants=network-online.target
[Service]
Type=simple
User=jason
WorkingDirectory=/opt/solarinet/current
ExecStart=/opt/solarinet/current/bin/solariMonitor --config /home/jason/Code/Solarinet/run/monitor/monitor.conf --loop
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
