# /etc/systemd/system/solarinet-client.service
[Unit]
Description=SolariNet client agent (host metrics -> server ingest)
After=network-online.target solarinet-server.service
Wants=network-online.target

[Service]
Type=simple
User=jason
Group=jason
WorkingDirectory=/home/jason/Code/Solarinet
ExecStart=/home/jason/Code/Solarinet/build-io/src/client/solariClient --config /home/jason/Code/Solarinet/run/client.conf --loop
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
