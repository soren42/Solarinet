# /etc/systemd/system/sor-emit.service
; SolariNet SoR bidirectional-sync: change emitter (outbox -> sor.events)
; Install: see deploy/sorsync/README.md. Assumes repo at /home/jason/Code/Solarinet.
[Unit]
Description=SolariNet SoR sync — change emitter (outbox -> sor.events)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

StartLimitIntervalSec=60
StartLimitBurst=5
[Service]
Type=simple
User=jason
Group=jason
WorkingDirectory=/opt/solarinet/current/apps/sorsync
Environment=SORSYNC_CONF=/home/jason/Code/Solarinet/deploy/sorsync/sorsync.conf
ExecStart=/opt/solarinet/current/.venv/bin/python3 /opt/solarinet/current/apps/sorsync/sor_emitd.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
