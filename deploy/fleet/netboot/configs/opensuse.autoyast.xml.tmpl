<?xml version="1.0" encoding="UTF-8"?>
<!--
  ===========================================================================
  SolariNet Fleet Provisioning - openSUSE Leap/Tumbleweed AutoYaST (TEMPLATE)
  ===========================================================================
  Rendered per-host and served at:
      @@HTTP_BASE@@/configs/<mac-or-host>.xml
  linuxrc is pointed at it via the boot.ipxe kernel arg:
      autoyast=@@HTTP_BASE@@/configs/<mac>.xml  install=@@HTTP_BASE@@/.../repo

  TOKENS, each NAME wrapped in double at-signs (named bare here so the renderer never
    substitutes into this comment; see netboot/README.md):
    HOSTNAME FQDN DOMAIN TIMEZONE
    ADMIN_USER ADMIN_PWHASH AUTHORIZED_KEYS_XML
    DISK PACKAGES_XML PROV_RUN_ID
    HTTP_BASE ARCH SERVER_URL SERVER_NAME SERVER_IP SUSE_PRODUCT

  Reference: https://doc.opensuse.org/projects/autoyast/
  ===========================================================================
-->
<profile xmlns="http://www.suse.com/1.0/yast2ns"
         xmlns:config="http://www.suse.com/1.0/configns">

  <!-- ==== mode =========================================================== -->
  <!-- confirm defaults to true, which parks the install at the Installation  -->
  <!-- Settings screen waiting for a click. Unattended installs must not.     -->
  <!-- second_stage=false: everything here is written in the first stage.     -->
  <!-- A second stage would run on first boot holding logins (pam_nologin),   -->
  <!-- and if the installer was booted with ssh=1 it waits there for someone  -->
  <!-- to run yast.ssh, which no key on the new system allows.                -->
  <general>
    <mode>
      <confirm config:type="boolean">false</confirm>
      <second_stage config:type="boolean">false</second_stage>
    </mode>
  </general>
  <!-- report: warnings and notes time out instead of waiting for a click;    -->
  <!-- errors still stop so a broken install is never silently half-done.    -->
  <report>
    <errors>
      <show config:type="boolean">true</show>
      <timeout config:type="integer">0</timeout>
      <log config:type="boolean">true</log>
    </errors>
    <warnings>
      <show config:type="boolean">true</show>
      <timeout config:type="integer">10</timeout>
      <log config:type="boolean">true</log>
    </warnings>
    <messages>
      <show config:type="boolean">true</show>
      <timeout config:type="integer">10</timeout>
      <log config:type="boolean">true</log>
    </messages>
    <yesno_messages>
      <show config:type="boolean">true</show>
      <timeout config:type="integer">10</timeout>
      <log config:type="boolean">true</log>
    </yesno_messages>
  </report>

  <!-- ==== language / keyboard / timezone ================================= -->
  <language>
    <language>en_US</language>
    <languages></languages>
  </language>
  <keyboard>
    <keymap>english-us</keymap>
  </keyboard>
  <timezone>
    <hwclock>UTC</hwclock>
    <timezone>@@TIMEZONE@@</timezone>
  </timezone>

  <!-- ==== networking ===================================================== -->
  <!-- DHCP on the provisioning link; set the real hostname from the token.  -->
  <networking>
    <keep_install_network config:type="boolean">true</keep_install_network>
    <dns>
      <hostname>@@HOSTNAME@@</hostname>
    </dns>
  </networking>

  <!-- ==== bootloader ===================================================== -->
  <!-- "default" lets YaST pick per platform (grub2-efi on UEFI, grub2 on    -->
  <!-- BIOS). Plain "grub2" is BIOS GRUB and does not boot a UEFI-only box.  -->
  <bootloader>
    <loader_type>default</loader_type>
  </bootloader>

  <!-- ===================================================================== -->
  <!-- PARTITIONING  (conservative, single-root)                            -->
  <!-- ===================================================================== -->
  <!-- One btrfs root filling @@DISK@@ plus a small swap. use_snapshots is on -->
  <!-- (Leap default) for rollback safety. The disk is named explicitly so a -->
  <!-- multi-disk host never gets the wrong device wiped.                    -->
  <!--                                                                       -->
  <!-- WARNING: initialize=true ERASES @@DISK@@ unattended.                  -->
  <partitioning config:type="list">
    <drive>
      <device>@@DISK@@</device>
      <initialize config:type="boolean">true</initialize>
      <use>all</use>
      <partitions config:type="list">
        <!-- swap: 1 GiB -->
        <partition>
          <mount>swap</mount>
          <filesystem config:type="symbol">swap</filesystem>
          <size>1G</size>
        </partition>
        <!-- root: remainder of the disk -->
        <partition>
          <mount>/</mount>
          <filesystem config:type="symbol">btrfs</filesystem>
          <size>max</size>
        </partition>
      </partitions>
    </drive>
  </partitioning>

  <!-- ==== software ======================================================= -->
  <!-- base + minimal server patterns plus the bootstrap packages: the      -->
  <!-- render step emits ONE <package> element per name (openSUSE names,    -->
  <!-- FLEET_BOOTSTRAP_PACKAGES_SUSE). Everything else (Core and the other  -->
  <!-- stacks) is applied after first boot by prov-finish.py over SSH.      -->
  <software>
    <!-- Base product: the Tumbleweed repo offers several (Aeon, Kalpa, MicroOS, -->
    <!-- openSUSE); without this the install stops on an error dialog.       -->
    <products config:type="list">
      <product>@@SUSE_PRODUCT@@</product>
    </products>
    <install_recommended config:type="boolean">false</install_recommended>
    <patterns config:type="list">
      <pattern>base</pattern>
      <pattern>enhanced_base</pattern>
      <pattern>minimal_base</pattern>
    </patterns>
    <packages config:type="list">
@@PACKAGES_XML@@
    </packages>
  </software>

  <!-- ==== services ======================================================= -->
  <services-manager>
    <default_target>multi-user</default_target>
    <!-- Current schema form. The SLE 11 <service>/<service_status> form   -->
    <!-- fails AutoYaST's profile validation, which stops an unattended    -->
    <!-- install at a confirmation dialog nobody is there to answer.       -->
    <services>
      <enable config:type="list">
        <service>sshd</service>
      </enable>
    </services>
  </services-manager>

  <!-- ==== firewall ======================================================= -->
  <!-- Enabling sshd does not open its port. With no <firewall> section the -->
  <!-- product default applies: firewalld on, ssh closed unless the install -->
  <!-- was booted with ssh=1. That locks out prov-finish (Ansible over SSH) -->
  <!-- and the operator, so open ssh in the default zone explicitly. The   -->
  <!-- list REPLACES the zone's services, so keep firewalld's stock         -->
  <!-- public-zone dhcpv6-client alongside it.                              -->
  <firewall>
    <enable_firewall config:type="boolean">true</enable_firewall>
    <start_firewall config:type="boolean">true</start_firewall>
    <default_zone>public</default_zone>
    <zones config:type="list">
      <zone>
        <name>public</name>
        <services config:type="list">
          <service>ssh</service>
          <service>dhcpv6-client</service>
        </services>
      </zone>
    </zones>
  </firewall>

  <!-- ==== accounts ======================================================= -->
  <!-- root password locked-ish (set to the same hash but SSH is key-only);  -->
  <!-- admin user gets the operator key and, for a PROV_STAGE install, the  -->
  <!-- provisioning host's Ansible control key (one <listentry> each).      -->
  <!-- Passwordless sudo is granted in the                                  -->
  <!-- post-install chroot script below. @@ADMIN_PWHASH@@ is a crypt(3) hash.-->
  <users config:type="list">
    <user>
      <username>root</username>
      <user_password>@@ADMIN_PWHASH@@</user_password>
      <encrypted config:type="boolean">true</encrypted>
    </user>
    <user>
      <username>@@ADMIN_USER@@</username>
      <user_password>@@ADMIN_PWHASH@@</user_password>
      <encrypted config:type="boolean">true</encrypted>
      <home>/home/@@ADMIN_USER@@</home>
      <shell>/bin/bash</shell>
      <authorized_keys config:type="list">
@@AUTHORIZED_KEYS_XML@@
      </authorized_keys>
    </user>
  </users>

  <!-- ===================================================================== -->
  <!-- POST-INSTALL SCRIPT (runs chrooted in the installed system)          -->
  <!-- ===================================================================== -->
  <!-- chrooted=true => runs inside the freshly installed root after the     -->
  <!-- package install. We grant passwordless sudo, record the PROV_STAGE   -->
  <!-- run id as an Ansible local fact (prov-finish.py's "this install of   -->
  <!-- run N completed" signal), then fetch                                 -->
  <!-- solari-firstboot.sh and run it with the SolariNet tokens as env vars. -->
  <scripts>
    <chroot-scripts config:type="list">
      <script>
        <filename>solari-firstboot</filename>
        <chrooted config:type="boolean">true</chrooted>
        <interpreter>shell</interpreter>
        <source><![CDATA[#!/bin/sh
set -e
# passwordless sudo for the admin user
printf '@@ADMIN_USER@@ ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/010-solari-admin
chmod 440 /etc/sudoers.d/010-solari-admin

# PROV_STAGE run marker (empty for a plain FLEET_PROVISION install)
if [ -n '@@PROV_RUN_ID@@' ]; then
  install -d -m 0755 /etc/ansible/facts.d
  printf '{"run_id": @@PROV_RUN_ID@@}\n' > /etc/ansible/facts.d/solari_prov.fact
  chmod 0644 /etc/ansible/facts.d/solari_prov.fact
fi

# python3 for Ansible and solariClient's shared library: neither is installed
# here, since zypper in this chroot loses to YaST's libzypp lock. The library
# is a profile <package> (FLEET_AGENT_LIBS_SUSE); prov-finish.py installs
# python3 over SSH once the host is up.

# fetch + run the SolariNet first-boot installer
curl --fail --silent --show-error --location \
    @@HTTP_BASE@@/installers/solari-firstboot.sh \
    -o /usr/local/sbin/solari-firstboot.sh
chmod 0755 /usr/local/sbin/solari-firstboot.sh

SOLARI_HTTP_BASE='@@HTTP_BASE@@' \
SOLARI_ARCH='@@ARCH@@' \
SOLARI_HOSTNAME='@@HOSTNAME@@' \
SOLARI_FQDN='@@FQDN@@' \
SOLARI_SERVER_URL='@@SERVER_URL@@' \
SOLARI_SERVER_NAME='@@SERVER_NAME@@' \
SOLARI_SERVER_IP='@@SERVER_IP@@' \
    sh /usr/local/sbin/solari-firstboot.sh
]]></source>
      </script>
    </chroot-scripts>
  </scripts>

</profile>
