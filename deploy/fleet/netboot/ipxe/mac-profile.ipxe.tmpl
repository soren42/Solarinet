#!ipxe
# =============================================================================
# SolariNet Fleet Provisioning - per-MAC staged auto-install profile
# =============================================================================
#
# Rendered ONLY by deploy/fleet/netbootlib.py render_mac_profile() (called by
# fleet-provision.sh for FLEET_PROVISION / PROV_STAGE), which validates every
# value it substitutes, and written to:
#     <HTTP_ROOT>/ipxe/mac-@@MAC@@.ipxe
# where the MAC is the booting NIC in lowercase hyphen form (aa-bb-cc-dd-ee-ff),
# matching iPXE's ${net0/mac:hexhyp}.
#
# boot.ipxe chains to this file FIRST. If it exists, the machine installs the
# staged image unattended on next boot. If it does NOT exist (the common case),
# the chain 404s and boot.ipxe falls through to its menu and then to "boot
# local disk" - so an un-staged machine is never wiped.
#
# @@BOOT_BLOCK@@ is the same kernel/initrd/boot block, from the same image
# directory (installers/<distro>/<release>/<arch>/), as the image's boot menu
# entry - generated by one function, so the two can never drift.
#
# ONE-SHOT SEMANTICS: this script cannot delete its own file. Until the target's
# firstboot reports success and the profile is un-staged, a reboot reinstalls.
# The firstboot marker /etc/solari/PENDING_ENROLLMENT is the signal to un-stage.
# =============================================================================

set base @@HTTP_BASE@@
set cfgkey @@MAC@@

# Shared cmdline fragments (kept identical to boot.ipxe).
set cmdline_common console=tty0 console=ttyS0,115200n8
set debian_cmdline auto=true priority=critical locale=en_US.UTF-8 keymap=us

echo
echo ================================================================
echo  SolariNet: STAGED unattended install
echo  hostname : @@HOSTNAME@@
echo  image    : @@IMAGE_TITLE@@
echo  mac      : ${net0/mac}
echo ================================================================
echo  This machine was pre-staged from the dashboard and will be
echo  INSTALLED NOW. The target disk will be ERASED.
echo ================================================================
echo Continuing in 10 seconds (power off to abort) ...
sleep 10

@@BOOT_BLOCK@@

# Fail safe: return control to boot.ipxe, which will boot the local disk.
:giveup
echo Staged install could not start; returning to firmware/local boot.
exit 1
