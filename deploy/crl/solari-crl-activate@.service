[Unit]
Description=Verify and activate the SolariNet CRL for the %i service
Documentation=https://github.com/soren42/Solarinet
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Validation has a 120-second budget. The outer limit leaves 240 seconds for
# bounded activation/recovery restarts and restoration of the size-capped bundle.
TimeoutStartSec=360
User=root
Group=root
StateDirectory=solari-crl-active
StateDirectoryMode=0755
UMask=0022
EnvironmentFile=/etc/solarinet/crl-activation-%i.conf
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /usr/local/libexec/solarinet/activate_crl.py --url ${CRL_URL} --base-ca-bundle ${BASE_CA_BUNDLE} --issuer-ca ${ISSUER_CA} --active-bundle /var/lib/solari-crl-active/%i.pem --service ${SOLARI_SERVICE}

# The updater has no CA private-key access. It writes only the active public
# trust bundle and may restart one allowlisted SolariNet unit.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/solari-crl-active
