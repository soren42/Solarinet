; Sends a fail-soft notification when a SolariNet backup unit fails.
[Unit]
Description=Notify SolariNet backup failure (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
; Run as root to avoid assuming a dedicated notify user exists on backup hosts.
User=root
Group=root
UMask=0077
TimeoutStartSec=15s
Environment=SOLARI_NOTIFY_PYTHON=/usr/bin/python3
EnvironmentFile=-/etc/solari-notify-failure-%i.conf
ExecStart=/usr/bin/env ${SOLARI_NOTIFY_PYTHON} /opt/solari-backups/solari-notify-failure.py --unit solari-backup@%i.service
