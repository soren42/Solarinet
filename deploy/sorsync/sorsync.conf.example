# SolariNet SoR bidirectional-sync config. Copy to sorsync.conf (gitignored) and
# fill real credentials. Read by sor_emitd / sor_apply_dnsd / sor_reconcile_discovery.

[sor]
host = 10.1.0.200
port = 3306
user = solari_sor_ro
password = REPLACE_WITH_UNIQUE_SECRET
name = sor

# Separate identities limit compromise of each worker. For a staged migration,
# omitted sections retain the [sor] fallback until their credentials are ready.
[sor_emit]
host = 10.1.0.200
port = 3306
user = solari_sor_emit
password = REPLACE_WITH_UNIQUE_SECRET
name = sor

[sor_discovery]
host = 10.1.0.200
port = 3306
user = solari_sor_discovery
password = REPLACE_WITH_UNIQUE_SECRET
name = sor

[sor_unifi]
host = 10.1.0.200
port = 3306
user = solari_sor_unifi
password = REPLACE_WITH_UNIQUE_SECRET
name = sor

[amqp]
# RabbitMQ on benzene. url includes vhost: amqp://user:pass@host:5672/vhost
url = amqp://solari:CHANGEME-rabbitmq-pw@10.5.2.50:5672/solari
exchange = sor.events
poll_interval_sec = 2
reconnect_delay_sec = 5
# CDC tables with no bound consumer; published without the mandatory flag so
# they cannot stall the outbox. Remove a table once an applier binds it.
# optional_tables = vlans,dhcp_ranges,external_refs
# Optional isolated/test queue override; production defaults to sor.apply.dns.
# dns_queue = sor.apply.dns

[dns]
# Requires reviewed root-owned release helpers and completed primary/secondary
# bootstrap before starting this applier. Credentials come from [sor].
gen_zones = /home/jason/Code/Solarinet/netdb/gen-zones.py
render_python = /home/jason/Code/Solarinet/deploy/sorsync/.venv/bin/python3
domain = akoria.net
incoming_root = /var/lib/solarinet-dns/incoming
target_state_file = /var/lib/solarinet-dns/state/targets.json
applied_zone_dir = /etc/bind/solarinet-current/zones
runtime_zone_dir = /etc/bind/solarinet-current/zones
release_helper = /usr/local/libexec/solarinet-dns-release
release_config = /etc/solarinet/dns-release.json
gen_bare = /home/jason/Code/Solarinet/deploy/dns-bare/gen-bare.py
secondary_refresh_helper = /usr/local/libexec/solari-dns-secondary-refresh
primary_address = 10.0.0.20
primary_config = /etc/bind/named.conf.akoria
primary_additional_configs = /etc/bind/named.conf.bare,/etc/bind/named.conf.local,/etc/bind/named.conf.rpz
secondary_refresh_timeout_sec = 150
debounce_sec = 4
reconcile_interval_sec = 3600

[dns.secondary.chlorine]
address = 10.7.0.10
ssh_host = jason@chlorine
update_helper = /usr/local/sbin/solari-bind9-update-zones

# Add a named secondary section only after that host is provisioned, reachable,
# serving zones, and configured for AXFR/NOTIFY from xenon. Steel is not active.

[discovery]
# sor_reconcile_discovery: fold detected hosts/services into the SoR.
mon_host = 127.0.0.1
mon_port = 3306
mon_user = solari
mon_password = CHANGME-solarinet-db-pw
mon_name = solarinet
interval_sec = 60
# provenance: the sources.id to attribute machine-detected rows to
source_label = monitoring

[pihole]
targets = helium, mercury
domain = akoria.net
debounce_sec = 4
reconcile_interval_sec = 3600

[pihole.helium]
ssh = jason@10.0.0.254
custom_list = /etc/pihole/custom.list
reload = sudo pihole reloaddns

[pihole.mercury]
ssh = jason@10.0.0.253
custom_list = /DATA/AppData/pihole/etc/pihole/custom.list
reload = sudo docker exec pihole pihole reloaddns

# sor_apply_ad (deployed on radium, the DC): reconcile akoria.org from the SoR.
[ad]
dc = localhost
zone = akoria.org
admin_user = administrator
admin_pw_file = /root/.ad-admin-pw
protect = radium
debounce_sec = 4
# periodic self-heal reconcile even when idle (0 disables). Default 1h.
reconcile_interval_sec = 3600
state_file = /opt/solari-sorsync/ad-managed.json
