# SolariNet Authenticator broker — config (example)
#
# Copy to authbroker.conf (same dir) and edit. authbroker.conf is gitignored;
# it holds the MQTT password and the dashboard bearer token.
#
#   cp deploy/authbroker/authbroker.conf.example deploy/authbroker/authbroker.conf
#   chmod 600 deploy/authbroker/authbroker.conf
#
# Format: INI (Python configparser).

[mqtt]
# Mosquitto on benzene. The certificate must contain this DNS name.
host = benzene.akoria.net
port = 8883
username = solari
password = CHANGE_ME
tls = true
ca_cert = /etc/solarinet/mqtt-ca.pem
client_id = authbrokerd

[http]
# The tiny HTTP API the dashboard calls. Keep it bound to localhost (or the
# dashboard host) — it must NOT be internet-reachable. `token` is a shared
# bearer secret the dashboard sends in `Authorization: Bearer <token>`. The
# daemon refuses to start if this is empty or left at the example value.
bind = 127.0.0.1
port = 9444
token = CHANGE_ME_LONG_RANDOM

[broker]
# Topic namespace: requests on <prefix>/request/<id>, responses on
# <prefix>/response/<id>. request_ttl_sec bounds how long a login waits.
topic_prefix = auth
request_ttl_sec = 60
request_signing_key_id = primary
request_signing_key_file = /home/jason/.config/solarinet/authbroker-request-signing.pem
allow_plaintext_dev = false

# ---- Enrolled devices ------------------------------------------------------
# One [device.<id>] section per Tab5. <id> must match the device_id the
# firmware reports in its signed responses. The pubkey is PUBLIC — safe to
# store here; the matching private key lives only in the Tab5's encrypted NVS.
# Generate a pair with:  ./enroll_device.py tab5-desk
#
# [device.tab5-desk]
# pubkey_pem =
#     -----BEGIN PUBLIC KEY-----
#     MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE...
#     -----END PUBLIC KEY-----
