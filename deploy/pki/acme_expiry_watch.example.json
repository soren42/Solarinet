{
  "schema_version": 1,
  "warning_days": 21,
  "critical_days": 7,
  "state_file": "/var/lib/solarinet-pki/acme-expiry-state.json",
  "notify_command": [
    "/usr/local/libexec/solarinet-pki/notify-send.py",
    "--config",
    "/etc/solarinet/pki/notify.conf"
  ],
  "services": [
    {
      "id": "example_web",
      "certificate": "/etc/letsencrypt/live/example.invalid/fullchain.pem",
      "domains": ["example.invalid", "www.example.invalid"]
    }
  ]
}
