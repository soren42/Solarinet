# Include inside the verified HTTPS VirtualHost selected for the trust portal.
# Publish immutable artifacts under /var/lib/solarinet/pki/trust/releases and
# keep current as a root-owned symlink to the active release.
# This serves only static public trust material; it does not issue certificates.
# Requires mod_alias and mod_headers (for example, a2enmod alias headers).
# Review the complete VirtualHost: no overlapping <Location>/<LocationMatch>
# section may assign a handler to /trust/, because Location sections merge after
# Files/Directory sections. Check the vhost again after including this example.

RedirectMatch 302 ^/trust$ /trust/
Alias /trust/ /var/lib/solarinet/pki/trust/current/

<Directory /var/lib/solarinet/pki/trust>
    Options -Indexes -ExecCGI -Includes -FollowSymLinks +SymLinksIfOwnerMatch
    AllowOverride None
    Require all granted

    # Never execute uploaded/generated content as a server-side handler.
    RemoveHandler .php .phps .phtml .phar .cgi .pl .py
    SetHandler default-handler

    Header always set X-Content-Type-Options "nosniff"
    Header always set Cache-Control "no-cache"

    <FilesMatch "\.mobileconfig$">
        ForceType application/x-apple-aspen-config
    </FilesMatch>

    # Deny script-like files even when a server-wide Files/FilesMatch PHP handler is active.
    <FilesMatch "(?i)\.(?:php|phps|phtml|phar|cgi|pl|py)$">
        Require all denied
        SetHandler default-handler
    </FilesMatch>
</Directory>
