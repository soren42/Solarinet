[Unit]
Description=Check deployed SolariNet web certificate expiry and publish alerts
Documentation=file:/usr/local/share/doc/solarinet-pki/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -I /usr/local/libexec/solarinet-pki/acme_expiry_watch.py --config /etc/solarinet/pki/acme_expiry_watch.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=60
StateDirectory=solarinet-pki
StateDirectoryMode=0700
