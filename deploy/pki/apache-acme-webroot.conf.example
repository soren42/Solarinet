# Include inside the intended Apache VirtualHost. Enable mod_alias first.
Alias /.well-known/acme-challenge/ /var/lib/solarinet/acme-webroot/.well-known/acme-challenge/

<Directory "/var/lib/solarinet/acme-webroot/.well-known/acme-challenge/">
    Options None
    AllowOverride None
    Require all granted
</Directory>
